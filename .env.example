# Netlify > Site configuration > Environment variables
SESSION_SECRET=         # required: long random string (openssl rand -hex 32)
BASE_URL=               # e.g. https://your-site.netlify.app (or custom domain)
STEAM_API_KEY=          # optional: Steam profile data
RATINGS_URL=            # optional: JSON url instead of ratings.json
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BRIDGE_URL=
WEBSITE_BRIDGE_SECRET=
